from datetime import datetime

# -----------------------------
# Return test Database
# -----------------------------

returns = {
    "RET-2005": {
        "status": "Refunded",
        "payment_method": "Credit Card",
        "refund_date": "2026-08-06"
    },
    "RET-2001": {
        "status": "Approved",
        "pickup_date": "2026-08-14",
        "refund_date": "2026-08-18"
    },
    "RET-2004": {
        "status": "Approved",
        "replacement_order": "NS-1008"
    },
    "RET-2003": {
        "status": "Pending Review",
        "within_window": True
    }
}

orders = {
    "NS-1002": {
        "order_date": "2026-08-12"
    }
}

CURRENT_DATE = datetime.strptime("2026-08-14", "%Y-%m-%d")


# -----------------------------
# Test Case 1
# Refund Status Completed
# -----------------------------
def test_ret_01():
    data = returns["RET-2005"]
    assert data["status"] == "Refunded"
    assert data["refund_date"] == "2026-08-06"
    print("TC-RET-01: PASS")


# -----------------------------
# Test Case 2
# Refund In Progress
# -----------------------------
def test_ret_02():
    data = returns["RET-2001"]
    assert data["status"] == "Approved"
    print("Pickup Date:", data["pickup_date"])
    print("Expected Refund:", data["refund_date"])
    print("TC-RET-02: PASS")


# -----------------------------
# Test Case 3
# 14-Day Eligibility
# -----------------------------
def test_ret_03():
    order = orders["NS-1002"]
    order_date = datetime.strptime(order["order_date"], "%Y-%m-%d")
    days = (CURRENT_DATE - order_date).days

    assert days <= 14
    print(f"Order Age: {days} days")
    print("TC-RET-03: PASS")


# -----------------------------
# Test Case 4
# Exchange Logic
# -----------------------------
def test_ret_04():
    data = returns["RET-2004"]
    assert data["status"] == "Approved"
    assert data["replacement_order"] == "NS-1008"
    print("Replacement Order:", data["replacement_order"])
    print("TC-RET-04: PASS")


# -----------------------------
# Test Case 5
# Pending Review
# -----------------------------
def test_ret_05():
    data = returns["RET-2003"]
    assert data["status"] == "Pending Review"
    assert data["within_window"] is True
    print("Customer should be notified: Awaiting approval.")
    print("TC-RET-05: PASS")
